generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  username     String      @unique
  passwordHash String
  displayName  String
  role         String      // "ADMIN" or "SALE"
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  tokens       Token[]     @relation("UserTokens")
  tokenNotes   TokenNote[] @relation("UserTokenNotes")
  farmAccounts FarmAccount[] @relation("UserFarmAccounts")
  farmInviterPlays FarmInviterPlay[] @relation("UserFarmInviterPlays")
  farmInviteePlays FarmInviteePlay[] @relation("UserFarmInviteePlays")
  messageTemplates MessageTemplate[] @relation("UserMessageTemplates")
  farmInviters     FarmInviter[]     @relation("UserFarmInviters")
  farmInvitees     FarmInvitee[]     @relation("UserFarmInvitees")
}

model VipPackage {
  id                 String   @id @default(uuid())
  name               String
  durationDays       Float
  fovMin             Int      @default(20)
  fovMax             Int      @default(90)
  bossRefreshMin     Int      @default(1)
  bossRefreshMax     Int      @default(60)
  maxMoveSpeed       Float    @default(2.5)
  maxAttackSpeed     Float    @default(2.5)
  maxMonsterRange    Int      @default(50)
  maxPickupCount     Int      @default(100)
  pickupDelayMin     Int      @default(100)
  pickupDelayMax     Int      @default(500)
  activeTabBasic     Boolean  @default(true)
  activeTabAdvanced  Boolean  @default(true)
  activeTabAutofarm  Boolean  @default(true)
  price              Float    @default(0)
  createdAt          DateTime @default(now())
  tokens             Token[]
}

model Token {
  id                      String      @id @default(uuid())
  tokenKey                String      @unique @default(uuid())
  deviceSnMd5             String
  characterUid            String
  packageId               String?
  vipPackage              VipPackage? @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  durationDays            Float
  expireAt                DateTime
  fovMin                  Int         @default(20)
  fovMax                  Int         @default(90)
  bossRefreshMin          Int         @default(1)
  bossRefreshMax          Int         @default(60)
  maxMoveSpeed            Float       @default(2.5)
  maxAttackSpeed          Float       @default(2.5)
  maxMonsterRange         Int         @default(50)
  maxPickupCount          Int         @default(100)
  pickupDelayMin          Int         @default(100)
  pickupDelayMax          Int         @default(500)
  activeTabBasic          Boolean     @default(true)
  activeTabAdvanced       Boolean     @default(true)
  activeTabAutofarm       Boolean     @default(true)
  characterReincarnation          Int         @default(8)
  characterReincarnationSecondary Int         @default(7)
  adminTelegrams          String      @default("[\"@admin1\", \"@admin2\"]")
  price                   Float       @default(0)
  isCustom                Boolean     @default(false)
  customerName            String?
  isTest                  Boolean     @default(false)
  isDeleted               Boolean     @default(false)
  deletedAt               DateTime?
  type                    String      @default("CUSTOMER") // "CUSTOMER" | "SVIP"
  encryptedToken          String      @db.NVarChar(Max)
  createdById             String
  createdBy               User        @relation("UserTokens", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  lastOnline              DateTime?
  lastCharacterName       String?
  lastServerName          String?
  notes                   TokenNote[]

  parentId                String?
  parent                  Token?      @relation("ParentChildTokens", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children                Token[]     @relation("ParentChildTokens")

  @@index([deviceSnMd5, characterUid])
  @@index([type])
}

model TokenNote {
  id          String   @id @default(uuid())
  tokenId     String
  token       Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String
  createdBy   User     @relation("UserTokenNotes", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action      String   // CREATE, UPDATE, SOFT_DELETE, HARD_DELETE, RESTORE
  detail      String   @db.NVarChar(Max)
  createdAt   DateTime @default(now())
}

model TelegramContact {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MessageTemplate {
  id          String   @id @default(uuid())
  title       String
  shortcut    String?
  category    String   @default("BÁO GIÁ")
  content     String   @db.NVarChar(Max)
  imageUrl    String?  @db.NVarChar(Max)
  isGlobal    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById String
  createdBy   User     @relation("UserMessageTemplates", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeviceLoginHistory {
  id            String   @id @default(uuid())
  deviceSnMd5   String
  characterUid  String
  characterName String?
  serverName    String?
  status        String   // "SUCCESS" | "FAILED"
  type          String   @default("CUSTOMER") // "CUSTOMER" | "SVIP"
  createdAt     DateTime @default(now())

  @@index([deviceSnMd5])
  @@index([createdAt])
  @@index([type])
}

// =========================================================================
// [MOD FEATURE]: FARM KC - MA MOI RONG VANG (FarmInviter / FarmInvitee)
// Mo ta: Luu acc Lv200 (nguoi moi) va acc Lv50 (nguoi duoc moi) do ban Farm
//        day len, kem co che giu cho (lease) chong vuot 5 luot moi.
// =========================================================================

// =========================================================================
// [MOD FEATURE]: FARM KC - KHO MAC DINH ACC Lv200 (chi de doi chieu)
// Mo ta: Chi giu thong tin dinh danh tu file dang ky. Tien do choi tren tung
//        server nam o FarmInviterPlay (quan he plays).
// =========================================================================
model FarmInviter {
  id          String            @id @default(uuid())
  email       String            @unique
  password    String            @default("")
  stt         Int               @default(0)
  uid         String            @default("")
  regIp       String            @default("")
  regAt       DateTime?
  importBatch String            @default("")
  createdById String
  createdBy   User              @relation("UserFarmInviters", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Cac lan acc nay duoc choi tren tung server (bang theo doi)
  plays       FarmInviterPlay[] @relation("InviterMasterPlays")

  @@index([stt])
  @@index([createdById])
}

// =========================================================================
// [MOD FEATURE]: FARM KC - KHO MAC DINH ACC Lv50 (chi de doi chieu)
// =========================================================================
model FarmInvitee {
  id          String            @id @default(uuid())
  email       String            @unique
  password    String            @default("")
  stt         Int               @default(0)
  uid         String            @default("")
  regIp       String            @default("")
  regAt       DateTime?
  importBatch String            @default("")
  createdById String
  createdBy   User              @relation("UserFarmInvitees", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  /// Cac lan acc nay duoc choi tren tung server (bang theo doi)
  plays       FarmInviteePlay[] @relation("InviteeMasterPlays")

  @@index([stt])
  @@index([createdById])
}

// =========================================================================
// [MOD FEATURE]: FARM KC - TAI KHOAN FARM_KC
// Mo ta: Tai khoan dung de chay bot farm. Moi tai khoan duoc giao mot khoang
//        STT acc game (level 50 hoac 200) tren mot server; khong cho 2 tai
//        khoan cung farmLevel + cung serverId nhan trung khoang STT.
//        status: NEW (chua chay) | RUNNING | PAUSED | DONE
// =========================================================================
model FarmAccount {
  id          String        @id @default(uuid())
  username    String        @unique
  password    String        @default("")
  note        String?
  // [MOD FEATURE]: muc tieu san luong kim cuong khach muon cay
  targetKc    Int           @default(0)
  // [MOD FEATURE]: AN CHIA voi khach - % khach nhan (100 = khach nhan het).
  //   Phan con lai (100 - tyLeKhach) gom ve acc game nhan cua minh.
  tyLeKhach   Int           @default(100)
  tkNhan      String?
  mkNhan      String?
  status      String        @default("NEW")
  lastSyncAt  DateTime?
  createdById String
  createdBy   User          @relation("UserFarmAccounts", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ranges      FarmAccountRange[] @relation("FarmAccountRanges")
  inviterPlays FarmInviterPlay[] @relation("FarmAccountInviterPlays")
  inviteePlays FarmInviteePlay[] @relation("FarmAccountInviteePlays")

  @@index([createdById])
}

// =========================================================================
// [MOD FEATURE]: FARM KC - KHOANG STT THEO TUNG LEVEL
// Mo ta: Moi dong la MOT CONG VIEC: cay level nao, tren server nao, khoang
//        STT nao. Mot tai khoan co nhieu dong -> cay nhieu level tren nhieu
//        server cung luc. Khong cho 2 dong cung level + cung server nhan
//        trung khoang STT (ke ca cua chinh minh).
// =========================================================================
model FarmAccountRange {
  id            String      @id @default(uuid())
  farmAccountId String
  farmAccount   FarmAccount @relation("FarmAccountRanges", fields: [farmAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Ma dinh danh cong viec, mod gui kem moi request: LONGDT-S517-L50-01
  jobCode       String      @unique
  farmLevel     Int
  serverId      Int         @default(0)
  serverName    String      @default("")
  rangeFrom     Int         @default(0)
  rangeTo       Int         @default(0)
  status        String      @default("NEW")
  /// Khoa thiet bi: gia lap nao dang giu viec nay
  deviceId      String?
  deviceName    String?
  lastHeartbeat DateTime?
  /// STT acc dang chay toi (de mod chay tiep khi mo lai)
  cursorStt     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Mot tai khoan co the co nhieu viec cung server + level (khac dai STT)
  @@index([farmAccountId])
  @@index([farmLevel, serverId])
}

// =========================================================================
// [MOD FEATURE]: FARM KC - BANG THEO DOI ACC GAME x SERVER x NGUOI CHOI
// Mo ta: FarmInviter / FarmInvitee la KHO MAC DINH - chi de doi chieu.
//        Tien do choi cua tung acc tren tung server nam o day.
//        Cung mot acc choi o 2 server = 2 dong, doc lap hoan toan.
// =========================================================================
model FarmInviterPlay {
  id             String        @id @default(uuid())
  masterId       String?
  master         FarmInviter?  @relation("InviterMasterPlays", fields: [masterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stt            Int           @default(0)
  email          String
  password       String        @default("")
  serverId       Int
  serverName     String        @default("")
  roleId         String        @default("")
  roleName       String        @default("")
  level          Int           @default(0)
  inviteCode     String?
  gameInviteNum  Int           @default(0)
  confirmedCount Int           @default(0)
  reservedCount  Int           @default(0)
  maxInvites     Int           @default(5)
  unboundGold    BigInt        @default(0)
  unboundDiamond BigInt        @default(0)
  goldVoucher    BigInt        @default(0)
  packBought     Int           @default(0)
  status         String        @default("NEW")
  failCount      Int           @default(0)
  lastError      String?
  lastSyncAt     DateTime?
  farmAccountId  String?
  farmAccount    FarmAccount?  @relation("FarmAccountInviterPlays", fields: [farmAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobCode        String?
  createdById    String
  createdBy      User          @relation("UserFarmInviterPlays", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  /// [MOD FEATURE]: FARM KC - khoa co han (lease) o muc tai khoan
  leaseDeviceId   String?
  leaseDeviceName String?
  leaseUntil      DateTime?
  invitees       FarmInviteePlay[] @relation("InviterPlayInvitees")

  @@unique([email, serverId])
  @@index([serverId, status])
  @@index([masterId])
  @@index([farmAccountId])
  @@index([createdById])
}

model FarmInviteePlay {
  id            String           @id @default(uuid())
  masterId      String?
  master        FarmInvitee?     @relation("InviteeMasterPlays", fields: [masterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stt           Int              @default(0)
  email         String
  password      String           @default("")
  serverId      Int
  serverName    String           @default("")
  roleId        String           @default("")
  roleName      String           @default("")
  level         Int              @default(0)
  inviterId     String?
  inviter       FarmInviterPlay? @relation("InviterPlayInvitees", fields: [inviterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inviteCode    String?
  status        String           @default("NEW")
  deviceId      String?
  reservedAt    DateTime?
  expireAt      DateTime?
  confirmedAt   DateTime?
  errorMsg      String?
  farmAccountId String?
  farmAccount   FarmAccount?     @relation("FarmAccountInviteePlays", fields: [farmAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  jobCode       String?
  createdById   String
  createdBy     User             @relation("UserFarmInviteePlays", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  /// [MOD FEATURE]: FARM KC - khoa co han (lease) o muc tai khoan
  leaseDeviceId   String?
  leaseDeviceName String?
  leaseUntil      DateTime?

  @@unique([email, serverId])
  @@index([serverId, status])
  @@index([masterId])
  @@index([inviterId])
  @@index([farmAccountId])
  @@index([createdById])
}
